# Create a key at https://openrouter.ai/settings/keys, then copy this file to .env.
# Never commit the real key.
OPENROUTER_API_KEY=replace_with_your_openrouter_key

# OpenRouter's free router chooses a currently available free model.
# Change this to a specific OpenRouter model slug later if you need repeatability.
OPENROUTER_MODEL=openrouter/free

# Optional tuning values.
CARDINAL_TEMPERATURE=0.2
CARDINAL_MAX_TOKENS=600
